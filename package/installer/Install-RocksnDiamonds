; $VER: Install-RocksnDiamonds 4.4.2.4-amiga1-rc1 (17.11.2026)
; The Amiga Installer script for Rocks'n'Diamonds, an AmiCradle game port.
; Made by amicradle scripts/ports/port_installer.py, with one line changed by hand (marked).
; Run it from its icon, beside the RocksnDiamonds drawer where the archive was unpacked.

(set @app-name "Rocks'n'Diamonds")
(set #version "4.4.2.4-amiga1-rc1")
(set #drawer "RocksnDiamonds")
(set #program "rocksndiamonds")
(set #space 29297)  ; KB

(onerror
    (message (cat "Rocks'n'Diamonds was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-RocksnDiamonds again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "Rocks'n'Diamonds needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "Rocks'n'Diamonds needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "Rocks'n'Diamonds needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The RocksnDiamonds drawer is not beside Install-RocksnDiamonds. Unpack the whole archive, then run Install-RocksnDiamonds from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The RocksnDiamonds drawer has no rocksndiamonds in it. Unpack the whole archive again."))

(welcome "This installs Rocks'n'Diamonds 4.4.2.4-amiga1-rc1 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the RocksnDiamonds drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called RocksnDiamonds in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": Rocks'n'Diamonds needs 30 MB free.")))

; GFOpenGPU's modules: in LIBS:GFOpenGPU/, or copied there from LIBS:OpenGPU/
; (older instances have only that); none is copied before all are found
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2.module" (noreq)) 1))
    (abort "Rocks'n'Diamonds needs GFOpenGPU's SDL2.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-RocksnDiamonds again. Nothing has been installed."))
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2_image.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2_image.module" (noreq)) 1))
    (abort "Rocks'n'Diamonds needs GFOpenGPU's SDL2_image.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-RocksnDiamonds again. Nothing has been installed."))
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2_mixer.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2_mixer.module" (noreq)) 1))
    (abort "Rocks'n'Diamonds needs GFOpenGPU's SDL2_mixer.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-RocksnDiamonds again. Nothing has been installed."))
(if (and (<> (exists "LIBS:GFOpenGPU/GL.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/GL.module" (noreq)) 1))
    (abort "Rocks'n'Diamonds needs GFOpenGPU's GL.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-RocksnDiamonds again. Nothing has been installed."))
(if (<> (exists "LIBS:GFOpenGPU" (noreq)) 2)
    (makedir "LIBS:GFOpenGPU"))
(if (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2.module")))
(if (<> (exists "LIBS:GFOpenGPU/SDL2_image.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2_image.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2_image.module")))
(if (<> (exists "LIBS:GFOpenGPU/SDL2_mixer.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2_mixer.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2_mixer.module")))
(if (<> (exists "LIBS:GFOpenGPU/GL.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying GL.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "GL.module")))
(complete 20)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "userdata") (noreq))
    (set #kept (if (= #kept "") "userdata" (cat #kept "|" "userdata"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying Rocks'n'Diamonds")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating Rocks'n'Diamonds. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "RocksnDiamonds.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "RocksnDiamonds.info")))

(set #later "")

; the game data the drawer does not carry: downloaded with C:Atlas, or copied from
; the player's own drawer, disk or CD; each file's SHA-256 checked where the spec names it
(set #atlas (= (exists "C:Atlas" (noreq)) 1))

; the game's graphics, sounds, music and levels, from upstream's own release
(set #into1 #dest)
(if (<> (exists #into1 (noreq)) 2) (makedir #into1))
; the game data are drawers, so each must exist as a drawer (2), not a file (1):
; changed by hand from port_installer.py's file check
(set #have (and (= (exists (tackon #into1 "graphics") (noreq)) 2) (= (exists (tackon #into1 "sounds") (noreq)) 2) (= (exists (tackon #into1 "music") (noreq)) 2) (= (exists (tackon #into1 "levels") (noreq)) 2) (= (exists (tackon #into1 "docs") (noreq)) 2) (= (exists (tackon #into1 "conf") (noreq)) 2)))
(if (not #have)
    (
        (set #how
            (askchoice
                (prompt "Rocks'n'Diamonds needs the game's graphics, sounds, music and levels, from upstream's own release. How should the Installer get it?")
                (help "Rocks'n'Diamonds needs the game's graphics, sounds, music and levels, from upstream's own release: graphics, sounds, music, levels, docs, conf, in the drawer itself. Download fetches rocksndiamonds-4.4.2.4-win64.zip from https://www.artsoft.org/RELEASES/windows/rocksndiamonds/rocksndiamonds-4.4.2.4-win64.zip with C:Atlas (AmiPortAtlas) and checks its SHA-256. The files come from https://www.artsoft.org/rocksndiamonds/. Not now leaves the drawer as it is: run the Installer again later, or copy the files in yourself.")
                (choices "Download it now (6 MB, needs the network)" "Not now: I will put it in the drawer myself")
                (default 0)))
        (if (and (= #how 0) (not #atlas))
            (
                (message "C:Atlas, which downloads it, is not on this Amiga: install AmiPortAtlas (its C/Atlas goes in C:). Then run Install-RocksnDiamonds again.")
                (set #how 1)
            )
        )
        (if (= #how 0)
            (
                (set #arc1 (tackon #dest "rocksndiamonds-4.4.2.4-win64.zip"))
                (working "Downloading rocksndiamonds-4.4.2.4-win64.zip for the game's graphics, sounds, music and levels, from upstream's own release.")
                (set #rc 0)
                (if (not @pretend)
                    (set #rc (run (cat "C:Atlas FETCH URL=\"https://www.artsoft.org/RELEASES/windows/rocksndiamonds/rocksndiamonds-4.4.2.4-win64.zip\" TO=\"" #arc1 "\" SHA256=7bae82762038f701a46c523bcc98266f5ec5fc24f73f619e06c79cfaee8065fa"))))
                (if (<> #rc 0)
                    (
                        (message "The download of rocksndiamonds-4.4.2.4-win64.zip did not complete or did not check out. Rocks'n'Diamonds is installed without the game's graphics, sounds, music and levels, from upstream's own release: run Install-RocksnDiamonds again to try once more.")
                        (set #how 1)
                    )
                )
                (if (and (= #how 0) (<> (exists "SYS:Utilities/GFOpenCompress" (noreq)) 1))
                    (
                        (message "SYS:Utilities/GFOpenCompress, which unpacks rocksndiamonds-4.4.2.4-win64.zip, is not on this Amiga. It is left in the drawer: unpack it there yourself.")
                        (set #how 1)
                    )
                )
                (if (= #how 0)
                    (
                        (set #unpack (tackon #dest "Unpack"))
                        (if (= (exists #unpack (noreq)) 2) (delete #unpack (all) (optional "force")))
                        (makedir #unpack)
                        (working "Unpacking rocksndiamonds-4.4.2.4-win64.zip.")
                        (if (not @pretend) (run (cat "SYS:Utilities/GFOpenCompress x \"" #arc1 "\" \"" #unpack "\" >NIL:")))
                        (copyfiles
                            (prompt "Copying the game's graphics, sounds, music and levels, from upstream's own release")
                            (help @copyfiles-help)
                            (source (tackon #unpack "Rocks'n'Diamonds 4.4.2.4"))
                            (dest #into1)
                            (choices "graphics" "sounds" "music" "levels" "docs" "conf")
                            (optional "nofail" "force"))
                        (delete #unpack (all) (optional "force"))
                        (delete #arc1 (optional "force"))
                    )
                )
            )
        )
        (if (= #how 1)
            (set #later (if (= #later "") "the game's graphics, sounds, music and levels, from upstream's own release" (cat #later ", " "the game's graphics, sounds, music and levels, from upstream's own release")))
        )
    )
)
(complete 90)

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. Rocks'n'Diamonds would have gone in " #dest "."))
    (message (cat "Rocks'n'Diamonds 4.4.2.4-amiga1-rc1 is installed in " #dest "."
                  "\n\nTo start it, open the RocksnDiamonds drawer and double-click the rocksndiamonds icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept "."))
                  (if (= #later "") "" (cat "\n\nStill to add to the drawer: " #later ". Run Install-RocksnDiamonds again to fetch or copy it.")))))
(exit (quiet))

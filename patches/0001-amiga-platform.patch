+#if defined(PLATFORM_AMIGA)
+// AmigaDOS paths: "PROGDIR:" and "levels" make "PROGDIR:levels" (a "/" after
+// a device or assign name would mean its parent drawer), and "." is the
+// drawer itself, as on Unix
+static char *getAmigaPath2(const char *path1, const char *path2)
+{
+  size_t len1 = strlen(path1);
+
+  if (strEqual(path2, "."))
+    return getStringCopy(path1);
+
+  if (len1 == 0 || strEqual(path1, "."))
+    return getStringCopy(path2);
+
+  if (path1[len1 - 1] == ':' || path1[len1 - 1] == '/')
+    return getStringCat2(path1, path2);
+
+  return getStringCat2WithSeparator(path1, path2, STRING_PATH_SEPARATOR);
+}
+#endif
+
 char *getPath2(const char *path1, const char *path2)
 {
+#if defined(PLATFORM_AMIGA)
+  if (path1 == NULL || path2 == NULL)
+    return NULL;
+
+  return getAmigaPath2(path1, path2);
+#endif
+

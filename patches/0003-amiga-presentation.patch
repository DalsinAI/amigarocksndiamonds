+#if defined(PLATFORM_AMIGA)
+// AmigaOS, with the variable RND_FPS set (SetEnv RND_FPS 1): each second,
+// the frames shown, and the time each took to put on the screen (the
+// texture update, the copies and the present, without the wait for the
+// game's frame delay), in the log
+static void AmigaLogFrameRate(unsigned int work_ms)
+{
+  static int enabled = -1;
+  static unsigned int start = 0, frames = 0, work = 0, work_max = 0;
+  unsigned int now = SDL_GetTicks();
+
+  if (enabled < 0)
+  {
+    enabled = (getenv("RND_FPS") != NULL);
+
+    if (enabled)
+    {
+      Print("frame rate log on: ticks %u ms, performance counter %lu of %lu a second\n",
+	    now, (unsigned long)SDL_GetPerformanceCounter(),
+	    (unsigned long)SDL_GetPerformanceFrequency());
+      if (program.log_file != NULL)
+	fflush(program.log_file);
+    }
+  }
+
+  if (!enabled)
+    return;
+
+  if (start == 0)
+    start = now;
+
+  frames++;
+  work += work_ms;
+  if (work_ms > work_max)
+    work_max = work_ms;
+
+  if (now - start >= 1000 || frames >= 100)
+  {
+    Print("fps %.1f at %.3f s (screen update %.1f ms a frame, %u ms at most)\n",
+	  1000.0 * frames / (now - start), now / 1000.0,
+	  (double)work / frames, work_max);
+
+    if (program.log_file != NULL)
+      fflush(program.log_file);
+
+    start = now;
+    frames = work = work_max = 0;
+  }
+}
+#endif

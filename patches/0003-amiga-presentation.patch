+#if defined(PLATFORM_AMIGA)
+// AmigaOS, with the variable RND_FPS set (SetEnv RND_FPS 1): each second,
+// the frames shown, and the time each took to put on the screen (the
+// texture update, the copies and the present, without the wait for the
+// game's frame delay), through SDL's log (the program's output)
+static void AmigaLogFrameRate(unsigned int work_ms)
+{
+  static int enabled = -1;
+  static unsigned int start = 0, frames = 0, work = 0, work_max = 0;
+  unsigned int now = SDL_GetTicks();
+
+  if (enabled < 0)
+  {
+    // SDL's getenv (dos.library's GetVar), which sees ENV: as SetEnv sets it
+    enabled = (SDL_getenv("RND_FPS") != NULL);
+
+    SDL_Log("first frame shown %u ms after SDL started%s", now,
+	    enabled ? "; frame log on" : "");
+  }
+
+  if (!enabled)
+    return;
+
+  if (start == 0)
+    start = now;
+
+  frames++;
+  work += work_ms;
+  if (work_ms > work_max)
+    work_max = work_ms;
+
+  if (now - start >= 1000)
+  {
+    SDL_Log("fps %d.%d at %u.%03u s (screen update %u.%u ms a frame, %u ms at most)",
+	    (int)(10000 * frames / (now - start)) / 10,
+	    (int)(10000 * frames / (now - start)) % 10,
+	    now / 1000, now % 1000,
+	    10 * work / frames / 10, 10 * work / frames % 10, work_max);
+
+    start = now;
+    frames = work = work_max = 0;
+  }
+}
+#endif

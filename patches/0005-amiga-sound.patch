--- a/src/libgame/sdl.c
+++ b/src/libgame/sdl.c
@@ -81,6 +81,28 @@
 }
 
 #if defined(PLATFORM_AMIGA)
+// AmigaOS: SDL_mixer's buffers, counted in its post-mix hook (the audio
+// thread only counts; the main thread logs them with the frame rate)
+static volatile unsigned int amiga_audio_buffers = 0;
+static volatile unsigned int amiga_audio_late = 0;
+static volatile unsigned int amiga_audio_last = 0;
+static unsigned int amiga_audio_buffer_ms = 0;
+
+static void SDLCALL AmigaAudioPostMix(void *udata, Uint8 *stream, int len)
+{
+  unsigned int now = SDL_GetTicks();
+
+  // a buffer later than one and a half buffers after the one before it
+  if (amiga_audio_last != 0 &&
+      now - amiga_audio_last > amiga_audio_buffer_ms * 3 / 2)
+    amiga_audio_late++;
+
+  amiga_audio_last = now;
+  amiga_audio_buffers++;
+}
+#endif
+
+#if defined(PLATFORM_AMIGA)
 // AmigaOS, with the variable RND_FPS set (SetEnv RND_FPS 1): each second,
 // the frames shown, and the time each took to put on the screen (the
 // texture update, the copies and the present, without the wait for the
@@ -122,6 +144,24 @@
     start = now;
     frames = work = work_max = 0;
   }
+
+  // every five seconds: the audio buffers mixed, and how many came late
+  static unsigned int audio_start = 0;
+
+  if (audio_start == 0)
+    audio_start = now;
+
+  if (now - audio_start >= 5000 && amiga_audio_buffer_ms != 0)
+  {
+    unsigned int buffers = amiga_audio_buffers, late = amiga_audio_late;
+
+    amiga_audio_buffers = amiga_audio_late = 0;
+
+    SDL_Log("audio %u buffers in %u ms at %u.%03u s, %u late",
+	    buffers, now - audio_start, now / 1000, now % 1000, late);
+
+    audio_start = now;
+  }
 }
 #endif
 

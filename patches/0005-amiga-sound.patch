+    SDL_Log("SDL audio \"%s\": %d Hz, %d channels, format 0x%04x, %d samples a buffer (asked %d Hz, %d samples)",
+	    SDL_GetCurrentAudioDriver() ? SDL_GetCurrentAudioDriver() : "?",
+	    freq, channels, (unsigned int)format,
+	    setup.system.audio_fragment_size, audio.sample_rate,
+	    setup.system.audio_fragment_size);
+
+    Mix_SetPostMix(AmigaAudioPostMix, NULL);
+  }
+#endif
